// An object is used to store related information together using key-value pairs.

// 1. Object Literal

let person1 = {
    name: "Pushpak",
    age: 20,
    city: "Pune"
};
console.log(person1);  // { name: 'Pushpak', age: 20, city: 'Pune' }

let person2 = {
    name: "Arun",
    age: 30,
    isEmployee: true,
    salary: 50000
};
console.log(person2);    // { name: 'Arun', age: 30, isEmployee: true, salary: 50000 }

// 2. new Object()

let student = new Object();

student.name = "Prajakta";
student.age = 30;
student.role = "Tester";

console.log(student);                               // { name: 'Prajakta', age: 30, role: 'Tester' }

// 3. Constructor Function

function Student(name, age, role) {
    this.name = name;
    this.age = age;
    this.role = role;
}

let student1 = new Student("Prajakta", 30, "Tester");
let student2 = new Student("Rahul", 25, "Developer");

console.log(student1.name);                           // Prajakta
console.log(student2.name);                           // Rahul

// 4. class

class Student1 {
    constructor(name, age, role) {
        this.name = name;
        this.age = age;
        this.role = role;
    }
}
let student3 = new Student1("Prajakta", 30, "Tester");
let student4 = new Student1("Rahul", 25, "Developer");

console.log(student3.name);            // Prajakta
console.log(student4.role);            // Developer

