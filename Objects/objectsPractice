// count duplicates values with nested loop

let employee3 = {
    name: "Rahul",
    city: "Pune",
    role: "Tester",
    department: "QA",
    location: "Pune",
    fname: "Rahul",
    city1: "Pune"
};
let evalues3= Object.values(employee3);
let duplicates = [];

for(let i = 0; i < evalues3.length; i++){

    if(!duplicates.includes(evalues3[i])){

        let count = 0;

        for(let j = 0; j < evalues3.length; j++){

            if(evalues3[i] === evalues3[j]){
                count++;
            } 
        }

        console.log(evalues3[i], "=", count);

        duplicates.push(evalues3[i]);
    }
}
console.log(duplicates);

