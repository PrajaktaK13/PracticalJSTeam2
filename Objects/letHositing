/*
TDZ = Temporal Dead Zone, after decaration and before initialization
During this period, age exists in the scope but cannot be accessed.*/

console.log(age); //  ReferenceError: Cannot access 'age' before initialization
let age = 30;

// let inside the block
if (true) {
    let a = 20;
}
console.log(a);       // ReferenceError: a is not defined as let is block scoped
let a = 10;

// let with function
function test() {
    console.log(a);
    let a = 20;
}
test();                 // ReferenceError: can not access a before initialization

//let with function

let b = 10;

function test() {
    console.log(b);
    let b = 20;
}
test();                  // ReferenceError: can not access a before initialization

// object with let

console.log(person1);         // ReferenceError
console.log(person1.name);    // ReferenceError
let person1 = {
    name: "Prajakta",
    age: 30
};

// Scope+hoisting

let person2 = {
    name: "Prajakta"
};
function test() {
    console.log(person2); 
    let person2 = {
        name: "Rahul"
    };
}
test();                        // ReferenceError: Cannot access 'person2' before initialization

