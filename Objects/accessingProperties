// Adding a New Property

// Objects are modifiable.
// Suppose we have:
let person2 = {
    name: "Shri",
    age: 30
};
// We can add:
person2.city = "Pune";
// Now the object becomes:
person2 = {
    name: "Shri",
    age: 30,
    city: "Pune"
}
// We can also use brackets:
person2["salary"] = 50000;

// now object becomes:

person2 = {
    name: "Shri",
    age: 30,
    city: "Pune",
    salary : 50000
}
console.log(person2);                            // o/p: { name: 'Shri', age: 30, city: 'Pune', salary: 50000 }

// Modifying a Property

let person3 = {
    name: "Arun",
    age: 30
};

// We can change the age
person3.age = 31;
console.log(person3.age);                                         // o/p: 31

let property = "name";
console.log(person3[property]);                                   // o/p: Arun
console.log(person3.property);                                    // o/p: undefined(should use only [] in this case)

// Deleting a Property

delete person3.age;

console.log(person3);                                             // { name: 'Arun' }

// Object with an Array

let person4 = {
    name: "Arun",
    age: 30,
    skills: ["Java", "JavaScript", "Selenium"]
};
console.log(person4);  // o/p: { name: 'Arun', age: 30, skills: [ 'Java', 'JavaScript', 'Selenium' ] }

console.log(person4.skills);                     // o/p: ["Java", "JavaScript", "Selenium"]
console.log(person4.skills[0]);                  // o/p: Java

