// checking whether a property exists in an object.

// in operator:

let student = {
    name: "Arun",
    age: 30,
    city: "Pune"
};
console.log("name" in student);                 // true
console.log("salary" in student);               // false

// hasOwnProperty():
student.hasOwnProperty("name");                 // true

// Object.hasOwn()
console.log(Object.hasOwn(student, "name"));    // true
console.log(Object.hasOwn(student, "salary"));  // false

