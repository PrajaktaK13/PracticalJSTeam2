// Object with var

console.log(person);         // undefined

var person = {
    name: "Prajakta",
    age: 30
};

// Object with let
console.log(person);      // ReferenceError

let person = {
    name: "Prajakta",
    age: 30
};

//Object with const
console.log(person);       // ReferenceError

const person = {
    name: "Prajakta",
    age: 30
};

// can we access an object's property before declaration?

console.log(person.name);                   // TypeError

var person = {
    name: "Prajakta"
};

// Imp: The object is not hoisted but The variable that refers to the object is hoisted.

let person = {
    name: "Prajakta"
};

function test() {
    console.log(person);

    let person = {
        name: "Rahul"
    };
}

test();                       // ReferenceError: Cannot access 'person' before initialization




