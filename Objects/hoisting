// Hoisting means JavaScript processes certain declarations before executing the code

// Function Hoisting
greet();

function greet() {
    console.log("Hello");
}
// o/p: Hello Because the function declaration is available before execution reaches that line.

// var Hoisting
console.log(a);
var a = 10;           // undefined: var is hoisted and initialized with undefined.


// let Hoisting
let a;
console.log(a);         // undefined
console.log(b);         // ReferenceError

let b = 10;  
// let is also hoisted, but it cannot be accessed before its declaration is initialized.
// This period is called the: Temporal Dead Zone (TDZ)   

console.log(a);
const a = 10;            // // ReferenceError

// Function expression with var

greet();                          // TypeError: greet is not a function

var greet = function() {
    console.log("Hello");
};

// Function expression with let

greet();                         // ReferenceError: Because greet is in the Temporal Dead Zone.

let greet = function() {
    console.log("Hello");
};

// practice ex:1
var a = 10;

function test() {
    console.log(a);
    var a = 20;
}
test();                     // undefined

