// for loop

//printing 1 To 10
for (let i = 1; i <= 5; i++) {
    console.log(i);
}

// Printing odd numbers between 1 to 10.

for (let i = 1; i <= 10; i++) 
    { if (i % 2 !== 0) 
    { console.log(i); 
} }

//while loop

let i = 1;

while (i <= 5) {
    console.log(i);
    i++;
}

// do  while loop: executes the code at least once.

let i = 1; 

do {
    console.log(i);
    i++;
} while (i <= 5);

// for...of — used for VALUES // of → give me the values //Used with arrays/strings

let fruits = ["Apple", "Mango", "Banana"];

for (let fruit of fruits) {
    console.log(fruit);
}

// for...in — used for KEYS / indexes // in → give me the keys // Used for objects

let person = {
    name: "Prajakta",
    age: 30,
    city: "Pune"
};

for (let key in person) {
    console.log(key);
}                                   
/* Output: 
 name
 age 
 city */

 // If you want the values:

 for (let key in person) {
    console.log(person[key]);
}
/* Output:
Prajakta
30
Pune */

//break in loops
for (let i = 1; i <= 10; i++) {
    if (i === 6) {
        break;                                 //Terminates the loop.
    }
    console.log(i);
}// output: 1 2 3 4 5

// continue in loops

for (let i = 1; i <= 5; i++) {
    if (i === 3) {
        continue;                              // skip the specific iteration.
    }

    console.log(i);
}// output: 1 2 4 5